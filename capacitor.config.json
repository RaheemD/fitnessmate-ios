{
  "appId": "com.fitnessmate.app",
  "appName": "FitnessMate",
  "webDir": "www",
  "ios": {
    "scheme": "FitnessMate",
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "server": {
    "iosScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#111827"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#111827",
      "showSpinner": false
    }
  }
}
